# --- LinkedIn Credentials ---
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# --- Gmail Credentials (SMTP/IMAP) ---
# Note: Use a Gmail App Password, not your standard account password.
# App passwords can be generated under Google Account Security (2-Step Verification)
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- AI API Keys & Configurations ---
# Primary model for customization
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.0-flash

# Fallback model for value propositions
OPENROUTER_API_KEY=sk-or-v1-yourOpenRouterApiKeyHere
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Secondary fallback model
GROQ_API_KEY=gsk_yourGroqApiKeyHere
GROQ_MODEL=llama-3.3-70b-versatile

# --- Operational Settings ---
DRY_RUN=True
ADMIN_BCC_EMAIL=admin_outreach@example.com
TEAM_LEAD_CC_EMAIL=lead_recruiter@example.com
